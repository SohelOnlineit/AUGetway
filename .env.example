# Copy to repo-root `.env` for local API + Prisma CLI.
# Placeholders only — replace with local values. Never commit real secrets.

NODE_ENV=development
PORT=4000
# Production systemd sets HOST=127.0.0.1. Leave unset for local dev.
# HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000/api
APP_PUBLIC_URL=http://localhost:3000

# Neon PostgreSQL. Paste the pooled connection string from the Neon console.
# Keep the password only in this file. Do not put it in the README or in git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require&channel_binding=require&schema=public"

# Native Redis (no Docker required)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=amarpin:

# Generate local placeholders, e.g.:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=phase0-dev-access-secret-replace-me-32chars-min
JWT_REFRESH_SECRET=phase0-dev-refresh-secret-replace-me-32chars-min
DATA_ENCRYPTION_KEY=phase0-dev-encryption-key-replace-me-32b

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# Relative to apps/api cwd when running via nest/pm2
UPLOADS_DIR=../../uploads

# Mail: `dev` returns preview codes/links in API responses (non-production only).
# `noop` refuses outbound mail (safe default until a real provider is chosen).
MAIL_PROVIDER=dev

# Sandbox/mock payments (development only). Must be false when NODE_ENV=production.
# Live payment providers are not selected yet — do not enable production gateways here.
PAYMENT_SANDBOX_ENABLED=true

# Identity seed — REQUIRED to run `pnpm --filter @amarpin/api seed:identity`
# No default passwords exist in source. Provide your own strong values.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
# Optional development-only fake customer:
DEV_SEED_CUSTOMER_EMAIL=
DEV_SEED_CUSTOMER_PASSWORD=
# Production seed gate (keep false unless intentionally seeding):
ALLOW_ADMIN_SEED=false
