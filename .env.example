# Local API + Prisma. Copy to `.env`. Never commit real secrets.

NODE_ENV=development
PORT=4100
WEB_ORIGIN=http://127.0.0.1:3100
API_PUBLIC_URL=http://127.0.0.1:4100/api

# Local PostgreSQL (`pnpm db:local`) or a Neon pooled URL.
# Node's pg driver does not support channel_binding, so use sslmode=require.
DATABASE_URL="postgresql://uniqpay:uniqpay_local@127.0.0.1:5433/uniqpay?schema=public"

# At least 32 characters.
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

ADMIN_EMAIL=admin@pay.uniqbd.com
ADMIN_PASSWORD=replace-with-a-strong-password

NEXT_PUBLIC_API_URL=http://127.0.0.1:4100/api

# Emergency switch: set to 1 and restart the API to skip the Cloudflare Turnstile check
# if it ever blocks sign-in. Turnstile itself is configured in the desk: Security Monitoring.
# TURNSTILE_OFF=1
