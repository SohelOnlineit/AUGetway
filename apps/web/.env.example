# Copy to apps/web/.env.local (dev) or apps/web/.env.production.local (Ubuntu production).
# Placeholders only — no real secrets in git.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
INTERNAL_API_URL=http://127.0.0.1:4000/api

# Must match API JWT_ACCESS_SECRET (used by middleware to verify access cookies).
AUTH_JWT_ACCESS_SECRET=phase0-dev-access-secret-replace-me-32chars-min

# Production tip: point NEXT_PUBLIC_* at public HTTPS origins; keep INTERNAL_API_URL on loopback.

# Store deep links. Leave blank until the Android signing fingerprint and Apple Team ID exist.
# ANDROID_SHA256_AMARPIN=
# ANDROID_SHA256_UNIQBD=
# APPLE_TEAM_ID=
