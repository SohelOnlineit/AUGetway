{
  "expo": {
    "name": "AuGetway",
    "slug": "uniqbd-pay",
    "scheme": "uniqpay",
    "version": "1.0.12",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.uniqbd.pay",
      "versionCode": 13,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "permissions": ["READ_SMS", "SEND_SMS", "READ_PHONE_STATE", "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_SPECIAL_USE", "POST_NOTIFICATIONS", "WAKE_LOCK", "RECEIVE_BOOT_COMPLETED"]
    }
  }
}
