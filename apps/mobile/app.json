{
  "expo": {
    "name": "AU-Getway",
    "slug": "uniqbd-pay",
    "scheme": "uniqpay",
    "version": "2.33",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "android": {
      "package": "com.uniqbd.pay",
      "versionCode": 53,
      "softwareKeyboardLayoutMode": "resize",
      "usesCleartextTraffic": false,
      "allowBackup": false,
      "permissions": ["READ_SMS", "SEND_SMS", "READ_PHONE_STATE", "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS", "FOREGROUND_SERVICE", "FOREGROUND_SERVICE_SPECIAL_USE", "POST_NOTIFICATIONS", "WAKE_LOCK", "CHANGE_WIFI_STATE", "RECEIVE_BOOT_COMPLETED", "SCHEDULE_EXACT_ALARM", "USE_EXACT_ALARM"]
    }
  }
}
