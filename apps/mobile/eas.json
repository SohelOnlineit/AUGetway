{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "amarpin-preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_STOREFRONT": "amarpin",
        "EXPO_PUBLIC_SITE_URL": "https://amarpin.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "amarpin-production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STOREFRONT": "amarpin",
        "EXPO_PUBLIC_SITE_URL": "https://amarpin.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    },
    "uniqbd-preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_STOREFRONT": "uniqbd",
        "EXPO_PUBLIC_SITE_URL": "https://uniqbd.com"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "uniqbd-production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_STOREFRONT": "uniqbd",
        "EXPO_PUBLIC_SITE_URL": "https://uniqbd.com"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "amarpin-production": {},
    "uniqbd-production": {}
  }
}
