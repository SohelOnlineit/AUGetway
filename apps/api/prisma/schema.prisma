// Identity + Catalog (public read) schema.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum ThemePreference {
  SYSTEM
  LIGHT
  DARK
}

enum Role {
  CUSTOMER
  VIP
  RESELLER
  AFFILIATE
  SUPPLIER
  EDITOR
  ADMINISTRATOR
}

enum VerificationPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  LICENSE
  ACCOUNT
  GIFTCARD
  TOPUP
  SUBSCRIPTION
}

enum HomepageSectionType {
  FEATURED_PRODUCTS
  CATEGORY_PRODUCTS
  LATEST_PRODUCTS
}

enum InventoryStatus {
  AVAILABLE
  RESERVED
  SOLD
  DISABLED
}

/// Checkout → pending payment → paid → fulfilled / refunded (or cancelled).
enum OrderStatus {
  PENDING_PAYMENT
  PAID
  FULFILLED
  PARTIALLY_REFUNDED
  REFUNDED
  CANCELLED
}

enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundDestination {
  /// External provider / original payment rail — admin must record result.
  ORIGINAL_PROVIDER
  /// Credit customer wallet via WalletService ledger.
  WALLET
}

enum FulfillmentStatus {
  NOT_STARTED
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum PaymentProvider {
  SANDBOX
  UDDOKTAPAY
}

enum PaymentIntentStatus {
  REQUIRES_CONFIRMATION
  PROCESSING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELLED
}

enum PaymentEventKind {
  INTENT_CREATED
  SANDBOX_SIMULATE
  PROVIDER_CALLBACK
  VERIFIED
  FAILED
  EXPIRED
  DUPLICATE_IGNORED
  SETTLED
}

/// Placeholder row used only to prove migrations + connectivity in Phase 0.
model SystemMeta {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_meta")
}

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  passwordHash  String
  status        UserStatus @default(PENDING)
  emailVerified Boolean    @default(false)
  displayName   String?
  phone         String?
  /// Public profile photo. Stored as a 100×100 WebP under /api/content/media.
  avatarPath    String?
  theme         ThemePreference @default(SYSTEM)
  /// Staff-only note — never expose on customer APIs.
  adminNote     String?
  roles         Role[]     @default([CUSTOMER])
  /// Storefront shopper with no sign-in. Login stays blocked (email is not verified).
  isGuest       Boolean    @default(false)
  /// Site where this account was opened. Its mail uses that site's mailbox.
  storefront    String     @default("amarpin")
  guestToken    String?    @unique
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  sessions                AuthSession[]
  verificationTokens      VerificationToken[]
  auditEvents             AuditEvent[]
  cart                    Cart?
  orders                  Order[]
  wallet                  Wallet?
  wishlistItems           WishlistItem[]
  notifications           Notification[]
  notificationPreference  NotificationPreference?
  refunds                 Refund[]
  tickets                 Ticket[]                 @relation("TicketOwner")
  assignedTickets         Ticket[]                 @relation("TicketAssignee")
  ticketMessages          TicketMessage[]
  chatRoomsOwned          ChatRoom[]               @relation("ChatRoomCustomer")
  chatParticipations      ChatRoomParticipant[]
  chatMessages            ChatMessage[]
  blogPostsAuthored       BlogPost[]               @relation("BlogPostAuthor")
  productReviews          ProductReview[]
  couponRedemptions       CouponRedemption[]
  pointAccount            PointAccount?

  @@index([status])
  @@map("users")
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

enum WalletTransactionStatus {
  POSTED
}

/// One wallet per user. Balance only changes via WalletService ledger posts.
model Wallet {
  id           String   @id @default(cuid())
  userId       String   @unique
  currency     String   @default("BDT")
  /// Cached balance in minor units — must match ledger sum.
  balanceMinor Int      @default(0)
  /// Optimistic concurrency token; bumped on every posted entry.
  version      Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Immutable ledger row. No updates/deletes in application code.
model WalletTransaction {
  id                String                  @id @default(cuid())
  walletId          String
  type              WalletTransactionType
  /// Always positive; direction comes from `type`.
  amountMinor       Int
  balanceAfterMinor Int
  currency          String                  @default("BDT")
  status            WalletTransactionStatus @default(POSTED)
  referenceType     String?
  referenceId       String?
  description       String?
  idempotencyKey    String
  createdAt         DateTime                @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId, createdAt])
  @@map("wishlist_items")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

/// Delivery outcome for a channel. Never mark EMAIL/PUSH accepted without a real provider.
enum NotificationDeliveryStatus {
  PENDING
  SKIPPED_NO_PROVIDER
  FAILED
  ACCEPTED
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  /// Machine kind for dedupe / filtering (e.g. ticket.reply).
  kind      String    @default("general")
  title     String
  body      String
  href      String?
  /// Optional idempotency key per user+kind to suppress duplicates.
  idempotencyKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, kind, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationDelivery {
  id             String                     @id @default(cuid())
  notificationId String
  channel        NotificationChannel
  status         NotificationDeliveryStatus @default(PENDING)
  provider       String?
  failureReason  String?
  attemptedAt    DateTime?
  createdAt      DateTime                   @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, createdAt])
  @@map("notification_deliveries")
}

model NotificationPreference {
  userId         String   @id
  emailEnabled   Boolean  @default(true)
  inAppEnabled   Boolean  @default(true)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model AuthSession {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  familyId         String
  userAgent        String?
  ipHash           String?
  expiresAt        DateTime
  revokedAt        DateTime?
  replacedById     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("auth_sessions")
}

model VerificationToken {
  id        String              @id @default(cuid())
  userId    String
  purpose   VerificationPurpose
  tokenHash String              @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("verification_tokens")
}

model AuditEvent {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipHash     String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([action, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("audit_events")
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  parentId    String?
  /// Ancestor ids root → parent (JSON string array).
  path        String[] @default([])
  depth       Int      @default(0)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  imageUrl    String?
  seoTitle    String?
  seoDescription String?
  seoImageUrl String?
  noindex     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
  sections HomepageSection[]
  couponCategories CouponCategory[]

  @@index([isActive, sortOrder])
  @@index([parentId])
  @@map("categories")
}

model Brand {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  logoUrl        String?
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  noindex        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products Product[]

  @@index([isActive, sortOrder])
  @@map("brands")
}

model Product {
  id               String        @id @default(cuid())
  title            String
  slug             String        @unique
  titleNormalized  String
  description      String?
  shortDescription String?
  sku              String?       @unique
  status           ProductStatus @default(DRAFT)
  type             ProductType
  categoryId       String
  brandId          String?
  /// Price in minor units (poisha). Public API exposes this + currency.
  priceMinor       Int
  compareAtMinor   Int?
  currency         String        @default("BDT")
  featured         Boolean       @default(false)
  sortOrder        Int           @default(0)
  seoTitle         String?
  seoDescription   String?
  seoImageUrl      String?
  noindex          Boolean       @default(false)
  /// Storefront regions and sellable packages. Public price stays priceMinor.
  variationMeta    Json?
  publishedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  brand          Brand?          @relation(fields: [brandId], references: [id])
  images         ProductImage[]
  inventoryItems InventoryItem[]
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  couponProducts CouponProduct[]
  reviews        ProductReview[]
  seoProfiles    ProductSeo[]
  /// Approved-review aggregates only. Unapproved reviews never change these.
  ratingCount    Int             @default(0)
  ratingSum      Int             @default(0)
  /// Spend this many minor units to earn `pointReward` points. 10 points are worth 1 taka. 0 disables it.
  pointSpendMinor Int            @default(0)
  pointReward     Int            @default(0)

  @@index([status, createdAt])
  @@index([status, featured, sortOrder])
  @@index([status, categoryId, createdAt])
  @@index([status, brandId, createdAt])
  @@index([status, titleNormalized])
  @@index([status, priceMinor])
  @@map("products")
}

/// Loyalty balance for one customer. Changes only through PointEntry rows.
model PointAccount {
  id         String   @id @default(cuid())
  userId     String   @unique
  balance    Int      @default(0)
  /// Poisha value of the balance. 10 points = 100 poisha = 1 taka.
  valueMinor Int      @default(0)
  updatedAt  DateTime @updatedAt

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries PointEntry[]

  @@map("point_accounts")
}

/// Immutable points ledger. Positive rows are earned; negative rows are reversed.
model PointEntry {
  id             String   @id @default(cuid())
  accountId      String
  userId         String
  orderId        String?
  points         Int
  /// Poisha added or removed with this row. 100 poisha is 1 taka.
  valueMinor     Int      @default(0)
  balanceAfter   Int
  idempotencyKey String   @unique
  description    String
  createdAt      DateTime @default(now())

  account PointAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@map("point_entries")
}

model InventoryItem {
  id              String          @id @default(cuid())
  productId       String
  /// Variation package value id. Null codes are not tied to one package.
  packageValueId  String?
  /// AES-256-GCM payload (iv:ciphertext:tag). Never expose plaintext via API.
  codeCiphertext  String
  status          InventoryStatus @default(AVAILABLE)
  reservedOrderId String?
  reservedUntil   DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  reservedOrder Order?          @relation(fields: [reservedOrderId], references: [id], onDelete: SetNull)
  delivery      OrderDelivery?

  @@index([productId, status])
  @@index([productId, packageValueId, status])
  @@index([reservedOrderId])
  @@index([status, reservedUntil])
  @@map("inventory_items")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id             String   @id @default(cuid())
  cartId         String
  productId      String
  /// Selected variation package. Null keeps the product's listed price.
  packageValueId String?
  /// Buyer answers for this product's customer input boxes. [{ label, value }].
  customerInputs Json?
  quantity       Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Order {
  id                   String            @id @default(cuid())
  orderNumber          String            @unique
  userId               String
  status               OrderStatus       @default(PENDING_PAYMENT)
  fulfillmentStatus    FulfillmentStatus @default(NOT_STARTED)
  currency             String            @default("BDT")
  subtotalMinor        Int
  /// Server-computed. Never taken from the client.
  discountMinor        Int               @default(0)
  totalMinor           Int
  couponId             String?
  couponCode           String?
  /// Sales channel chosen at checkout. DIRECT is the storefront gateway. WALLET is wallet pay.
  originChannel        String            @default("DIRECT")
  /// Website the customer came from, such as Direct, Facebook, YouTube, or ChatGPT.
  originSource         String            @default("Direct")
  /// Site the customer was on when they placed the order.
  storefront           String            @default("amarpin")
  /// Contact captured at checkout. Guest orders have no real account email.
  contactName          String?
  contactPhone         String?
  contactEmail         String?
  /// Sum of SUCCEEDED refunds only (pending/processing excluded).
  refundedMinor        Int               @default(0)
  /// Client-supplied key for idempotent checkout (unique per user).
  idempotencyKey       String
  reservationExpiresAt DateTime
  paidAt               DateTime?
  fulfilledAt          DateTime?
  /// Set when an admin moves the order to trash. Hidden from normal lists.
  trashedAt            DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items           OrderItem[]
  inventoryItems  InventoryItem[]
  paymentIntents  PaymentIntent[]
  deliveries      OrderDelivery[]
  statusHistory   OrderStatusHistory[]
  refunds         Refund[]
  coupon          Coupon?              @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption CouponRedemption?

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([status, fulfillmentStatus])
  @@index([trashedAt])
  @@map("orders")
}

model Refund {
  id                 String            @id @default(cuid())
  orderId            String
  paymentIntentId    String?
  userId             String
  amountMinor        Int
  currency           String            @default("BDT")
  status             RefundStatus      @default(REQUESTED)
  destination        RefundDestination @default(ORIGINAL_PROVIDER)
  /// Customer-facing request reason.
  reason             String
  /// Unique per order for idempotent customer/admin create.
  idempotencyKey     String
  providerRef        String?
  requestedByUserId  String
  processedByUserId  String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentIntent PaymentIntent?        @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  history       RefundStatusHistory[]

  @@unique([orderId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([paymentIntentId])
  @@map("refunds")
}

model RefundStatusHistory {
  id          String        @id @default(cuid())
  refundId    String
  fromStatus  RefundStatus?
  toStatus    RefundStatus
  actorUserId String?
  /// Required for admin transitions.
  reason      String?
  metadata    Json?
  createdAt   DateTime      @default(now())

  refund Refund @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([refundId, createdAt])
  @@map("refund_status_history")
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  titleSnapshot  String
  slugSnapshot   String
  unitPriceMinor Int
  quantity       Int
  lineTotalMinor Int
  /// Package chosen at checkout. Stock is claimed from this package only after payment.
  packageValueId String?
  /// Snapshot of the buyer's "Your information" answers. [{ label, value }].
  customerInputs Json?

  order      Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Restrict)
  deliveries OrderDelivery[]

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  reason     String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderDelivery {
  id               String   @id @default(cuid())
  orderId          String
  orderItemId      String
  inventoryItemId  String   @unique
  productId        String
  titleSnapshot    String
  /// Encrypted code copy (AES-256-GCM). Never log plaintext.
  codeCiphertext   String
  deliveredAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([orderItemId])
  @@map("order_deliveries")
}

model PaymentIntent {
  id             String              @id @default(cuid())
  orderId        String
  provider       PaymentProvider     @default(SANDBOX)
  status         PaymentIntentStatus @default(REQUIRES_CONFIRMATION)
  amountMinor    Int
  currency       String              @default("BDT")
  /// Unique per order — retries reuse the same key safely.
  idempotencyKey String
  externalRef    String?
  /// Uddokta Pay channel, such as bkash, nagad, or rocket.
  paymentMethod  String?
  /// bKash, Nagad, or Rocket transaction id from the gateway.
  transactionId  String?
  expiresAt      DateTime
  succeededAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events  PaymentEvent[]
  refunds Refund[]

  @@unique([orderId, idempotencyKey])
  @@unique([provider, externalRef])
  @@index([orderId, status])
  @@index([status, expiresAt])
  @@map("payment_intents")
}

model PaymentEvent {
  id              String           @id @default(cuid())
  paymentIntentId String
  kind            PaymentEventKind
  /// Provider/sandbox event id for idempotent processing (unique per intent).
  providerEventId String
  /// Scrubbed metadata only — never store plaintext inventory codes.
  metadata        Json?
  createdAt       DateTime         @default(now())

  paymentIntent PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@unique([paymentIntentId, providerEventId])
  @@index([paymentIntentId, createdAt])
  @@map("payment_events")
}

model OrderNumberSequence {
  id        String @id @default("default")
  nextValue Int    @default(1000)

  @@map("order_number_sequences")
}

/// Search listing and product copy for one shop. AmarPin and UniQbd each keep their own row.
model ProductSeo {
  id               String  @id @default(cuid())
  productId        String
  storefront       String
  seoTitle         String?
  seoDescription   String?
  seoImageUrl      String?
  keywords         String?
  canonicalPath    String?
  noindex          Boolean @default(false)
  nofollow         Boolean @default(false)
  shortDescription String?
  description      String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, storefront])
  @@index([storefront, noindex])
  @@map("product_seo")
}

model ProductImage {
  id         String   @id @default(cuid())
  productId  String
  /// amarpin or uniqbd. Same product, different photo per shop.
  storefront String   @default("amarpin")
  url        String
  alt        String?
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, storefront, sortOrder])
  @@map("product_images")
}

model HomepageSlide {
  id         String   @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String
  linkUrl    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("homepage_slides")
}

model HomepageSection {
  id         String              @id @default(cuid())
  title      String
  type       HomepageSectionType
  categoryId String?
  productLimit Int               @default(8)
  sortOrder  Int                 @default(0)
  isActive   Boolean             @default(true)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  category Category? @relation(fields: [categoryId], references: [id])

  @@index([isActive, sortOrder])
  @@map("homepage_sections")
}

model NavigationItem {
  id        String   @id @default(cuid())
  label     String
  href      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("navigation_items")
}

/// Privacy-conscious storefront analytics. Never store PII, tokens, or chat text.
model AnalyticsEvent {
  id         String   @id @default(cuid())
  /// Allowlisted event name only.
  name       String
  /// Path without query string.
  path       String?
  entityType String?
  entityId   String?
  /// Opaque hashed visitor key — not an email/IP/user id.
  visitorKey String?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@map("analytics_events")
}

/// Singleton-ish CMS/SEO settings row (key = "default").
model SiteContentSettings {
  id               String   @id @default(cuid())
  key              String   @unique @default("default")
  siteName         String   @default("AmarPin")
  tagline          String?
  defaultSeoTitle  String?
  defaultSeoDescription String?
  canonicalBaseUrl String?
  robotsExtra      String?
  defaultOgImageUrl String?
  logoAlt          String   @default("AmarPin")
  lightLogoPath    String?
  darkLogoPath     String?
  adminFaviconPath String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("site_content_settings")
}

/// Singleton security policy row (id = "default").
model SecuritySettings {
  id                             String   @id @default("default")
  /// When non-empty, only these email hostnames may self-register; all others are blocked.
  registrationEmailAllowDomains  String[] @default([])
  /// When allowlist is empty: these hostnames cannot register. When allowlist is non-empty, this list is informational only (everything outside allow is already blocked).
  registrationEmailBlockDomains  String[] @default([])
  updatedAt                      DateTime @updatedAt

  @@map("security_settings")
}

enum AccessBlockKind {
  IP
  COUNTRY
}

/// Active IP or country deny rules. Inactive rows are kept for audit history.
model AccessBlock {
  id        String          @id @default(cuid())
  type      AccessBlockKind
  value     String
  reason    String?
  active    Boolean         @default(true)
  createdBy String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([type, value])
  @@index([active, type])
  @@map("access_blocks")
}

/// SEO for fixed public routes that are not products, CMS pages, or blog records.
enum RouteSeoKey {
  HOME
  PRODUCTS
  BLOG
  REQUEST_PRODUCT
}

model RouteSeo {
  key           RouteSeoKey @id
  path          String
  title         String?
  description   String?
  imageUrl      String?
  canonicalPath String?
  noindex       Boolean     @default(false)
  nofollow      Boolean     @default(false)
  updatedAt     DateTime    @updatedAt

  @@map("route_seo")
}

// —— Content / CMS ——

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SitePageKey {
  ABOUT
  CONTACT
  PRIVACY
  TERMS
  REFUND_POLICY
  DISCLAIMERS
}

enum ContactInquiryStatus {
  NEW
  READ
  REPLIED
  CLOSED
}

enum ContactMessageDirection {
  INBOUND
  OUTBOUND
}

/// Reply email delivery — never mark ACCEPTED without a real provider.
enum ContactReplyDeliveryStatus {
  NOT_APPLICABLE
  PENDING
  SKIPPED_NO_PROVIDER
  FAILED
  ACCEPTED
}

enum ProductRequestStatus {
  NEW
  REVIEWING
  REPLIED
  CLOSED
}

model BlogCategory {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  description    String?
  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  noindex        Boolean  @default(false)
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts BlogPost[]

  @@index([isActive, sortOrder])
  @@map("blog_categories")
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String?
  body           String
  coverImagePath String?
  status         BlogPostStatus @default(DRAFT)
  categoryId     String?
  authorUserId   String?
  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  noindex        Boolean        @default(false)
  publishedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  category BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author   User?         @relation("BlogPostAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@map("blog_posts")
}

/// Editable public marketing/legal pages (about, policies, contact intro).
model SitePage {
  id             String      @id @default(cuid())
  key            SitePageKey @unique
  title          String
  body           String      @default("")
  seoTitle       String?
  seoDescription String?
  seoImageUrl    String?
  noindex        Boolean     @default(false)
  isPublished    Boolean     @default(false)
  updatedAt      DateTime    @updatedAt
  createdAt      DateTime    @default(now())

  @@map("site_pages")
}

model ContactInquiry {
  id        String               @id @default(cuid())
  name      String
  email     String
  subject   String
  status    ContactInquiryStatus @default(NEW)
  readAt    DateTime?
  closedAt  DateTime?
  /// Site the customer was on when they wrote in.
  storefront String               @default("amarpin")
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  messages ContactInquiryMessage[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("contact_inquiries")
}

model ContactInquiryMessage {
  id             String                     @id @default(cuid())
  inquiryId      String
  direction      ContactMessageDirection
  body           String
  actorUserId    String?
  deliveryStatus ContactReplyDeliveryStatus @default(NOT_APPLICABLE)
  deliveryDetail String?
  createdAt      DateTime                   @default(now())

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@map("contact_inquiry_messages")
}

model ProductRequest {
  id           String               @id @default(cuid())
  productName  String
  customerName String
  email        String
  mobile       String
  details      String
  /// Site the customer was on when they sent the request.
  storefront   String               @default("amarpin")
  status       ProductRequestStatus @default(NEW)
  adminReply   String?
  /// Reply email delivery status — not faked as sent.
  replyDeliveryStatus ContactReplyDeliveryStatus @default(NOT_APPLICABLE)
  replyDeliveryDetail String?
  reviewedByUserId String?
  repliedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("product_requests")
}

// —— Support: tickets + live chat (text-only v1) ——

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ChatRoomStatus {
  OPEN
  CLOSED
}

enum ChatParticipantRole {
  CUSTOMER
  STAFF
}

model TicketNumberSequence {
  id        String @id @default("default")
  nextValue Int    @default(1000)

  @@map("ticket_number_sequences")
}

model Ticket {
  id               String         @id @default(cuid())
  ticketNumber     String         @unique
  userId           String
  subject          String
  status           TicketStatus   @default(OPEN)
  priority         TicketPriority @default(NORMAL)
  assignedToUserId String?
  /// Unique per customer for idempotent create.
  idempotencyKey   String
  closedAt         DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  user       User            @relation("TicketOwner", fields: [userId], references: [id], onDelete: Restrict)
  assignee   User?           @relation("TicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  messages   TicketMessage[]
  chatRoom   ChatRoom?

  @@unique([userId, idempotencyKey])
  @@index([status, updatedAt])
  @@index([assignedToUserId, status])
  @@index([userId, createdAt])
  @@map("tickets")
}

model TicketMessage {
  id             String   @id @default(cuid())
  ticketId       String
  authorUserId   String
  /// Text-only body (v1 — no attachments).
  body           String
  idempotencyKey String
  createdAt      DateTime @default(now())

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@unique([ticketId, idempotencyKey])
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model ChatRoom {
  id             String         @id @default(cuid())
  /// Optional 1:1 link to a support ticket.
  ticketId       String?        @unique
  customerUserId String
  status         ChatRoomStatus @default(OPEN)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  ticket       Ticket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  customer     User                  @relation("ChatRoomCustomer", fields: [customerUserId], references: [id], onDelete: Restrict)
  messages     ChatMessage[]
  participants ChatRoomParticipant[]

  @@index([customerUserId, updatedAt])
  @@index([status, updatedAt])
  @@map("chat_rooms")
}

model ChatRoomParticipant {
  id         String              @id @default(cuid())
  roomId     String
  userId     String
  role       ChatParticipantRole
  lastReadAt DateTime?
  lastSeenAt DateTime?
  joinedAt   DateTime            @default(now())

  room ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
  @@map("chat_room_participants")
}

model ChatMessage {
  id             String   @id @default(cuid())
  roomId         String
  senderUserId   String
  /// Caption. Empty when the message is a photo only.
  body           String
  /// Public media path for a photo sent in this chat.
  imageUrl       String?
  idempotencyKey String
  createdAt      DateTime @default(now())

  room   ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  sender User     @relation(fields: [senderUserId], references: [id], onDelete: Restrict)

  @@unique([roomId, idempotencyKey])
  @@index([roomId, createdAt])
  @@map("chat_messages")
}

// —— Coupons + reviews ——

enum CouponDiscountType {
  PERCENT
  FIXED
}

/// HELD while order is pending payment.
/// CONSUMED when payment settles.
/// RELEASED when the pending order is cancelled or the reservation expires.
/// Refunds do not release a consumed redemption.
enum CouponRedemptionStatus {
  HELD
  CONSUMED
  RELEASED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Coupon {
  id                String             @id @default(cuid())
  code              String             @unique
  discountType      CouponDiscountType
  /// Integer percent 1–100 when PERCENT.
  percent           Int?
  /// Minor units when FIXED. Currency must match the order.
  amountMinor       Int?
  currency          String             @default("BDT")
  isActive          Boolean            @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  maxRedemptions    Int?
  maxPerCustomer    Int?
  minSubtotalMinor  Int                @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  products     CouponProduct[]
  categories   CouponCategory[]
  redemptions  CouponRedemption[]
  orders       Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponProduct {
  couponId  String
  productId String

  coupon  Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
  @@map("coupon_products")
}

model CouponCategory {
  couponId   String
  categoryId String

  coupon   Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
  @@map("coupon_categories")
}

model CouponRedemption {
  id             String                 @id @default(cuid())
  couponId       String
  orderId        String                 @unique
  userId         String
  status         CouponRedemptionStatus @default(HELD)
  discountMinor  Int
  /// Same key as the order checkout idempotency key.
  idempotencyKey String
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([couponId, status])
  @@index([userId, couponId, status])
  @@map("coupon_redemptions")
}

model ProductReview {
  id                String       @id @default(cuid())
  productId         String
  userId            String
  rating            Int
  body              String
  status            ReviewStatus @default(PENDING)
  /// Set only from a server-side paid/fulfilled order check.
  verifiedPurchase  Boolean      @default(false)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("product_reviews")
}
