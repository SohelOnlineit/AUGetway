{
  "name": "@uniqpay/api",
  "version": "0.1.0",
  "private": true,
  "description": "UniqBD Pay NestJS 11 API",
  "scripts": {
    "prebuild": "pnpm run prisma:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "db:local": "node scripts/pg-local.mjs",
    "db:push": "prisma db push --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@uniqpay/types": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "embedded-postgres": "18.6.0-beta.19",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "dotenv": "17.2.3",
    "prisma": "7.10.1",
    "typescript": "5.9.3"
  }
}
