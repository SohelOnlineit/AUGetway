{
  "name": "@amarpin/api",
  "version": "0.1.0",
  "private": true,
  "description": "AuGetway NestJS 11 API (Phase 0 foundation)",
  "scripts": {
    "prebuild": "pnpm run prisma:generate",
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "pnpm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "echo \"@amarpin/api: no tests in Phase 0\"",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "seed:identity": "node scripts/seed-identity.cjs",
    "seed:catalog": "node scripts/seed-catalog.cjs",
    "seed:inventory": "node scripts/seed-inventory.cjs",
    "seed:account-demo": "node scripts/seed-account-demo.cjs"
  },
  "dependencies": {
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.2.8",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/websockets": "11.2.8",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@socket.io/redis-adapter": "8.3.0",
    "@amarpin/types": "workspace:*",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "joi": "17.13.9",
    "nestjs-pino": "4.6.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino-http": "10.5.0",
    "pino-pretty": "13.2.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/schematics": "11.0.9",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/passport-jwt": "4.0.1",
    "@types/pg": "8.15.5",
    "@amarpin/config-ts": "workspace:*",
    "dotenv": "17.2.3",
    "eslint": "9.36.0",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1"
  }
}
