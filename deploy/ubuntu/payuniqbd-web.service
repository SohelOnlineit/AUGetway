[Unit]
Description=AuGetway web
After=network-online.target payuniqbd-api.service
Wants=network-online.target

[Service]
Type=simple
User=payuniqbd
Group=payuniqbd
WorkingDirectory=/var/www/pay.uniqbd.com/apps/web
Environment=NODE_ENV=production
EnvironmentFile=/var/www/pay.uniqbd.com/apps/web/.env.production.local
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start --port 3001 --hostname 127.0.0.1
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
