# AmarPin: simple Redis unit (works on Ubuntu 22.04 / 24.04).
# Ubuntu 24.04's vendor unit uses systemd sandboxing that breaks jemalloc on some VPSes.
[Unit]
Description=Advanced key-value store
After=network.target

[Service]
Type=simple
User=redis
Group=redis
ExecStart=/usr/bin/redis-server /etc/redis/redis.conf --daemonize no
Restart=always
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
