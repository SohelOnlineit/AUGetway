# Copy to /var/www/amarpin.com/.env on the server. Placeholders only.

NODE_ENV=production
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
CORS_ORIGIN=https://amarpin.com,https://www.amarpin.com
API_PUBLIC_URL=https://api.amarpin.com/api
APP_PUBLIC_URL=https://amarpin.com
# PostgreSQL 18 on this VPS. Do not use a Neon URL.
DATABASE_URL="postgresql://amarpin:PASSWORD@127.0.0.1:5432/amarpin"
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=amarpin:
